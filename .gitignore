# ---- Python ----
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# ---- 运行时数据：绝不入库 ----
# 里面是行情/交易库，动辄几十 MB，而且含真实成交与账户状态。
data/*.db
data/*.db-wal
data/*.db-shm
data/*.png
data/*.csv
data/*.json
logs/

# ---- 凭证：绝不入库 ----
config/.env
*.pem
*.key
.env
.env.*
!deploy/env.server.example

# ---- 编辑器/系统 ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- 备份文件（改代码时留的）----
*.bak
*.bak-*
*.orig

# ---- 工具归档：历史脚本，保留但默认不入库 ----
# 需要时用 git add -f 单独纳入。
# 唯独 docs_outdated 例外：那里是【已经作废的规范】，
# 必须入库才能让下一个会话看到"这份过期了、别按它读"。
# 只放本地等于把知情的成本转嫁给未来的人。
_archive/*
!_archive/docs_outdated/
!_archive/docs_outdated/**