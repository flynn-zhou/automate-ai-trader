# /etc/ai-trader/env  —— systemd EnvironmentFile，权限 600
#
# 这是【完整】模板：代码里 os.environ.get("AI_...") 读到的每个变量都在这里。
# 由 tests/test_deploy_env_completeness.py 保证两边不分叉——
# 漏一个的后果不是报错，而是静默退回 config.py 的默认值，
# 于是"线上的配置"和"你以为的配置"变成两回事。

AI_LOG_LEVEL=INFO
AI_WEB_PORT=8090
# 区间演化实时推进间隔（秒）；0 = 关闭。默认 60
AI_RANGE_TICK_S=60
AI_WEB_TOKEN=
# ---- 后台登录（/admin）----
# 与 AI_WEB_TOKEN 分工：token 给机器调 /api/*，登录给人在浏览器里看页面。
# AI_WEB_PASS 为空 = 后台登录被禁用（登不进去，不是"随便进"）。
# 默认口令比没有口令更危险：它给人"我已经配好了"的错觉。
AI_WEB_USER=admin
AI_WEB_PASS=
# Flask session 签名密钥。留空会退化用 AI_WEB_TOKEN，
# 两个都空时用开发默认值——那等于任何人可伪造登录态，生产必须设一个。
AI_SECRET_KEY=
AI_DB_PATH=/home/cryptobot/ai-trader/data/market.db
AI_HTTP_PROXY=
AI_SYMBOL=BTCUSDT

# ---- 交易 ----
# paper = 纸面（不碰真钱）；live = 实盘
AI_TRADE_MODE=paper
AI_PAPER_BALANCE=100
# scalp 已被回测证伪（负期望）；trend = 4h SMA200；donchian = 1h 唐奇安通道
# donchian 是 2026-11-02 在 7.15 年 1h K 线上唯一通过逐年/滚动/样本外/
# 参数邻域/100U 真实账户 五道关的策略（donchian.py 模块 docstring 有全部数据）
AI_STRATEGY=trend
# spot 优于 perp：现货年化成本 6.22%，永续含资金费 11.46%
AI_EXEC_MARKET=spot
# 滞回带半宽（%）。0.2 为实测最优：CAGR 41.70%->45.06%，手续费少 21.7%
AI_TREND_HYST=0.2
# 唐奇安通道（AI_STRATEGY=donchian 时生效）。150/75 是通过五道关的那一组，
# 不能随便调：相邻参数 100/50 每笔只有 +0.87%，滚动正窗 5/7。
AI_DONCHIAN_ENTRY=150
AI_DONCHIAN_EXIT=75
# 逐笔流名：trade（逐笔）或 aggTrade（聚合成交）。
# 2026-11-02 实测：本环境下永续 @aggTrade 连得上但一条都不推
# （45 秒 0 条，同时 @trade 45 秒 195 条），所以用 trade。
AI_WS_STREAM=trade

# ---- 告警 ----
# install_sentinel.sh 会尝试从 /etc/cryptobot/env 自动补这一项
AI_FEISHU_WEBHOOK=

# ---- 实盘凭证（只放这里，不进代码库）----
AI_API_KEY=
AI_API_SECRET=
